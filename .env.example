# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，严禁提交真实密钥。
# 每项注释 = 含义 + 是否部署必填（standards §2.6）；缺省值见 app/core/config.py。

# PostgreSQL 连接串（psycopg3 驱动）。开发默认值即下行（rag:rag@localhost:5433/rag，
# 与 docker-compose.yml 的 dev 库一致）；【部署必填：改生产实例与强口令】
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# pg/pg-test 容器的初始化口令（compose 变量注入，§12.7 compose 内不落明文）。
# 与 DATABASE_URL 中的口令保持一致；已初始化的卷不随此值变化（变更须重建卷）。
# 【部署必填：换强口令】
POSTGRES_PASSWORD=rag

# JWT 签名密钥（≥32 字符，缺失应用拒绝启动）；【部署必填：换随机强密钥，如 openssl rand -base64 48】
JWT_SECRET=please-generate-a-random-secret-of-at-least-32-chars

# 访问令牌有效期（分钟）；【部署可选：缺省 480】
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 上传文件落盘目录（本地卷，对象存储演进位 §1.2）；【部署必核：与卷挂载路径一致，缺省 ./data/uploads】
STORAGE_DIR=./data/uploads

# TEI embedding 服务地址（BGE-M3）；【部署必填：指向生产 TEI 实例，本地开发用缺省 localhost:8091（dev compose 实映射端口）】
EMBED_BASE_URL=http://localhost:8091

# embedding 调用超时（秒）；【部署可选：缺省 60（2026-11-01 上调，known-issues 开放-1：
# 10s 为单条查询纪律值，入库批量在 CPU TEI 队列堆积可超——GPU 后与 rerank 一并回调）】
EMBED_TIMEOUT_S=60

# 单次批量嵌入的字符上限（大文档分批防超长请求；0=不分批，仅测试用）；【部署可选：缺省 1200】
EMBED_BATCH_CHARS=1200

# MinerU 解析服务地址（扫描件/复杂 PDF 用；留空=自动降级 pypdf）；【部署可选：留空走降级】
MINERU_BASE_URL=

# 老格式转换服务地址（Gotenberg/LibreOffice，doc/ppt/xls 自动转 OOXML 用；留空=老格式拒收并提示另存）；【部署可选：F-1015】
CONVERT_BASE_URL=

# 老格式转换超时（秒）；【部署可选：缺省 120】
CONVERT_TIMEOUT_S=120

# 内嵌图片 OCR（F-1017，2026-10-06）：文档内图片抽取→MinerU OCR→文字块参与检索；【部署可选：缺省 false 试点灰度】
# 开启前置条件：MINERU_BASE_URL 已配置且 MinerU 服务已启动；关闭时行为与现状一致
IMAGE_OCR_ENABLED=false

# MinerU 解析超时（秒）；【部署可选：缺省 300】
MINERU_TIMEOUT_S=300

# 测试模式（true=上传端点同步执行解析管道，仅供自动化测试）；【部署必核：生产必须 false】
TEST_MODE=false

# ------------------------------ W2 问答链路新增 ------------------------------
# （与 app/core/config.py 同名键一一对应，缺省值以 config.py 为准）

# TEI rerank 服务地址（BGE-reranker-v2-m3）；【部署必填：指向生产 TEI 实例，本地开发用缺省 localhost:8082】
RERANK_BASE_URL=http://localhost:8082

# rerank 调用超时（秒）；【部署可选：缺省 120（CPU TEI 实测 20 条×190 字 ≈110s，10s 纪律值
# 在该形态不可达；GPU 后收敛回纪律值并复测）】
RERANK_TIMEOUT_S=120

# LLM OpenAI 兼容端点：非 test_mode 必填（云 DeepSeek/GLM-4 或内网 vLLM 的 OpenAI 兼容端点）。
# 【部署必填（非 test_mode）：留空则装配期 fail-fast 拒启；test_mode 可留空走 Stub】
LLM_BASE_URL=

# LLM API 密钥（云 DeepSeek/GLM-4 端点鉴权用，内网 vLLM 无鉴权时可留空）；【部署必填（云端点时）：严禁把真实密钥提交进仓库】
LLM_API_KEY=

# 对话模型名（如 deepseek-flash，2026-09-29 决策 17 更新）；【部署必填（非 test_mode）：须与服务端模型名一致】
LLM_MODEL=

# 推理力度（deepseek-flash: low/high/max，缺省 low）。RAG 证据型问答正文优先：high 会把
# max_tokens 全烧在 reasoning 上致正文为空（2026-10-01 事故）；【部署可选：缺省 low】
LLM_EFFORT=low

# LLM 调用超时（秒）；【部署可选：缺省 60】
LLM_TIMEOUT_S=60

# 回答生成 max_tokens 上限；【部署可选：缺省 4096】
CHAT_MAX_TOKENS=4096

# 提示词包版本（对应 prompts/*.txt 头注释 # version）；【部署必核：与 prompts/ 目录实际版本一致】
PROMPT_VERSION=v1

# 单用户每日提问上限（超出拒答，防滥用）；【部署可选：缺省 200】
DAILY_QUESTION_LIMIT=200

# 问答对准入阈值（embedding 余弦相似度 ≥ 此值才走问答对直答；不得与 rerank 分混用，§4.4）；【部署可选：缺省 0.85，调整须附评测对比】
QA_THRESHOLD=0.85

# 拒答阈值（rerank 最高分低于此值直接拒答；两套阈值不得混用，standards §4.4）；【部署可选：缺省 0.55】
REFUSE_THRESHOLD=0.55

# 降级态拒答阈值（rerank 故障/熔断走向量序兜底时，分数口径=召回余弦；取对照带下沿 0.63，
# retrieval-policy §3）；【部署可选：缺省 0.63，实测后按降级态负例校准】
FALLBACK_REFUSE_THRESHOLD=0.63

# rerank 熔断总闸（连续 3 次失败开路 300s 后半开单发探测；false=恒 closed 不记失败）；【部署可选：缺省 true】
RERANK_BREAKER_ENABLED=true

# 问答结果缓存 TTL（秒）；【部署可选：缺省 300】
CACHE_TTL_S=300

# 进程内状态后端（工单 19）：memory=进程内字典（单实例，缺省）/ pg=外置三张 state_*
# 表（问答缓存/日限额/召回暂存/登录限流/登出黑名单，跨实例共享，多副本部署的前置）；
# TEST_MODE=true 时恒为 memory 不受本键影响；【部署可选：缺省 memory】
STATE_BACKEND=memory

# 向量检索候选数 top_k（重排前召回量）；【部署可选：缺省 20】
RETRIEVER_TOP_K=20

# 重排后保留条数 top_n（进入生成的片段数）；【部署可选：缺省 5】
RERANK_TOP_N=5

# 检索结果去重相似度阈值（≥ 视为重复片段丢弃）；【部署可选：缺省 0.98】
CHUNK_DEDUP_SIM=0.98

# pgvector HNSW 查询 ef_search（召回质量与延迟的权衡）；【部署可选：缺省 40】
HNSW_EF_SEARCH=40

# ------------------------------ W3 管理与运维新增 ------------------------------
# （与 app/core/config.py 同名键一一对应，缺省值以 config.py 为准）

# 提问记录保留天数（超过即归档停用，两段式清理第一阶段，standards §7.3/§4.6）；【部署可选：缺省 90】
MESSAGE_RETENTION_DAYS=90

# 提问记录归档后冷却天数（冷却期满物理清理，两段式清理第二阶段，§4.6）；【部署可选：缺省 30】
MESSAGE_CLEANUP_COOLDOWN_DAYS=30

# ------------------------------ Agent 演进新增（F-211/212，工单 #04） ------------------------------
# （与 app/core/config.py 同名键一一对应；Agent 模型档位三项留空 = 复用主问答通道，非部署必填）

# Agent 模型 OpenAI 兼容端点（模板生成等 agent 任务专用档位）；【部署可选：留空复用 LLM_BASE_URL】
AGENT_MODEL_BASE_URL=

# Agent 模型 API 密钥；【部署可选：留空复用 LLM_API_KEY；严禁把真实密钥提交进仓库】
AGENT_MODEL_API_KEY=

# Agent 模型名；【部署可选：留空复用 LLM_MODEL】
AGENT_MODEL_MODEL=

# Agent 模型调用超时（秒，chat 纪律与主通道一致）；【部署可选：缺省 60】
AGENT_MODEL_TIMEOUT_S=60

# 模型无原生 tool-calling 时启用 ReAct 文本协议兜底解析（协议见 app/core/agent_model.py docstring）；【部署可选：缺省 true】
AGENT_MODEL_REACT_FALLBACK=true

# ------------------------------ 评测集自动更新（评测自动闭环） ------------------------------
# （预算/阈值项为代码缺省不进本文件，见 app/core/config.py；此处仅总闸——部署稳定后开启）

# 评测自动闭环总闸：难例合成流水（周日 04:00）与三视角自动跑分（周日 05:00）启停；【部署可选：缺省 false】
EVAL_AUTO_ENABLED=false

# ------------------------------ 商用就绪部署新增（工单 20/21） ------------------------------
# （分级限流四项阈值为代码缺省不进本文件，见 app/core/config.py rate_*；STATE_BACKEND
# 已于上方工单 19 段登记——scale 拓扑必须 pg）

# 调度器启停开关：定时任务 + 启动补偿 + entrypoint 自愈段共用；多副本部署（scale 覆盖
# 文件）时 api 副本置 false、仅调度副本保持 true【部署可选：缺省 true】
SCHEDULER_ENABLED=true

# gunicorn worker 进程数（Dockerfile CMD 消费；1 ≈ 单进程 uvicorn 现形态，SSE 兼容）；
# 【部署可选：缺省 1】
WEB_CONCURRENCY=1
