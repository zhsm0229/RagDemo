# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，严禁提交真实密钥。
# 每项注释 = 含义 + 是否部署必填（standards §2.6）；缺省值见 app/core/config.py。

# PostgreSQL 连接串（psycopg3 驱动）。开发默认值即下行（rag:rag@localhost:5433/rag，
# 与 docker-compose.yml 的 dev 库一致）；【部署必填：改生产实例与强口令】
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# pg/pg-test 容器的初始化口令（compose 变量注入，§12.7 compose 内不落明文）。
# 与 DATABASE_URL 中的口令保持一致；已初始化的卷不随此值变化（变更须重建卷）。
# 【部署必填：换强口令】
POSTGRES_PASSWORD=rag

# JWT 签名密钥（≥32 字符，缺失应用拒绝启动）；【部署必填：换随机强密钥，如 openssl rand -base64 48】
JWT_SECRET=please-generate-a-random-secret-of-at-least-32-chars

# 访问令牌有效期（分钟）；【部署可选：缺省 480】
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 上传文件落盘目录（本地卷，对象存储演进位 §1.2）；【部署必核：与卷挂载路径一致，缺省 ./data/uploads】
STORAGE_DIR=./data/uploads

# TEI embedding 服务地址（BGE-M3）；【部署必填：指向生产 TEI 实例，本地开发用缺省 localhost:8081】
EMBED_BASE_URL=http://localhost:8081

# embedding 调用超时（秒，上限见 standards §1.4-5）；【部署可选：缺省 10】
EMBED_TIMEOUT_S=10

# MinerU 解析服务地址（扫描件/复杂 PDF 用；留空=自动降级 pypdf）；【部署可选：留空走降级】
MINERU_BASE_URL=

# MinerU 解析超时（秒）；【部署可选：缺省 300】
MINERU_TIMEOUT_S=300

# 测试模式（true=上传端点同步执行解析管道，仅供自动化测试）；【部署必核：生产必须 false】
TEST_MODE=false

# ------------------------------ W2 问答链路新增 ------------------------------
# （与 app/core/config.py 同名键一一对应，缺省值以 config.py 为准）

# TEI rerank 服务地址（BGE-reranker-v2-m3）；【部署必填：指向生产 TEI 实例，本地开发用缺省 localhost:8082】
RERANK_BASE_URL=http://localhost:8082

# rerank 调用超时（秒）；【部署可选：缺省 10】
RERANK_TIMEOUT_S=10

# LLM OpenAI 兼容端点：非 test_mode 必填（云 DeepSeek/GLM-4 或内网 vLLM 的 OpenAI 兼容端点）。
# 【部署必填（非 test_mode）：留空则装配期 fail-fast 拒启；test_mode 可留空走 Stub】
LLM_BASE_URL=

# LLM API 密钥（云 DeepSeek/GLM-4 端点鉴权用，内网 vLLM 无鉴权时可留空）；【部署必填（云端点时）：严禁把真实密钥提交进仓库】
LLM_API_KEY=

# 对话模型名（如 deepseek-flash，2026-09-29 决策 17 更新）；【部署必填（非 test_mode）：须与服务端模型名一致】
LLM_MODEL=

# 推理力度（deepseek-flash: low/high/max，缺省 low）。RAG 证据型问答正文优先：high 会把
# max_tokens 全烧在 reasoning 上致正文为空（2026-10-01 事故）；【部署可选：缺省 low】
LLM_EFFORT=low

# LLM 调用超时（秒）；【部署可选：缺省 60】
LLM_TIMEOUT_S=60

# 回答生成 max_tokens 上限；【部署可选：缺省 4096】
CHAT_MAX_TOKENS=4096

# 提示词包版本（对应 prompts/*.txt 头注释 # version）；【部署必核：与 prompts/ 目录实际版本一致】
PROMPT_VERSION=v1

# 单用户每日提问上限（超出拒答，防滥用）；【部署可选：缺省 200】
DAILY_QUESTION_LIMIT=200

# 问答对准入阈值（embedding 余弦相似度 ≥ 此值才走问答对直答；不得与 rerank 分混用，§4.4）；【部署可选：缺省 0.85，调整须附评测对比】
QA_THRESHOLD=0.85

# 拒答阈值（rerank 最高分低于此值直接拒答；两套阈值不得混用，standards §4.4）；【部署可选：缺省 0.55】
REFUSE_THRESHOLD=0.55

# 问答结果缓存 TTL（秒）；【部署可选：缺省 300】
CACHE_TTL_S=300

# 向量检索候选数 top_k（重排前召回量）；【部署可选：缺省 20】
RETRIEVER_TOP_K=20

# 重排后保留条数 top_n（进入生成的片段数）；【部署可选：缺省 5】
RERANK_TOP_N=5

# 检索结果去重相似度阈值（≥ 视为重复片段丢弃）；【部署可选：缺省 0.98】
CHUNK_DEDUP_SIM=0.98

# pgvector HNSW 查询 ef_search（召回质量与延迟的权衡）；【部署可选：缺省 40】
HNSW_EF_SEARCH=40

# ------------------------------ W3 管理与运维新增 ------------------------------
# （与 app/core/config.py 同名键一一对应，缺省值以 config.py 为准）

# 提问记录保留天数（超过即归档停用，两段式清理第一阶段，standards §7.3/§4.6）；【部署可选：缺省 90】
MESSAGE_RETENTION_DAYS=90

# 提问记录归档后冷却天数（冷却期满物理清理，两段式清理第二阶段，§4.6）；【部署可选：缺省 30】
MESSAGE_CLEANUP_COOLDOWN_DAYS=30
